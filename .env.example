# Copy to .env and fill in. .env is gitignored.
# Credentials come from https://developer.ups.com -> Apps -> Add App

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# Your UPS account number (the one that gets billed)
UPS_ACCOUNT=

# Always copied on UPS ship and delivery notification emails, in addition to
# the customer address from the order form. Comma-separate for several.
UPS_NOTIFY_EMAIL=

# cie  = free test sandbox, no charges
# prod = real labels, real charges
UPS_ENV=cie

# Printer density: 8 = 203 dpi (GC420d), 12 = 300 dpi
UPS_DPMM=8
